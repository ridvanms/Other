{
  "name": "@moodreel/web",
  "version": "1.0.0",
  "private": true,
  "description": "Уеб клиентът на MoodReel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "vite build --mode standalone",
